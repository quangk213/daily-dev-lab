{
  "manifest_version": 3,
  "name": "Open on My Monitor",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "settings.html"
  },
  "incognito": "not_allowed",
  "commands": {
    "send-to-monitor": {
      "suggested_key": {
        "default": "Alt + Q"
      },
      "description": "Open hovered link or current page on target monitor"
    }
  }
}
